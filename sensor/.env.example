# Copy to sensor/.env and fill in. sensor/.env is gitignored; never commit a real key.

# Quorum backend. Use 127.0.0.1 locally, or the laptop's LAN IP if the sensor runs elsewhere.
QUORUM_URL=http://127.0.0.1:8000

# Plain API key shown once when the sensor was created in Quorum (format: <id>.<secret>).
SENSOR_KEY=

# Webcam index (0 = built-in camera) or a stream URL, e.g. http://192.168.1.23:8080/video
VIDEO_SOURCE=0

# Seconds between readings sent to Quorum. Quorum allows at most one every 2 seconds.
INTERVAL_SECONDS=5

# Minimum YOLO confidence for a person detection (0 to 1).
CONFIDENCE=0.5

# Ultralytics model. Nano models are fastest on a laptop CPU. Downloaded on first run.
MODEL=yolo11n.pt
